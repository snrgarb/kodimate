<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="script.kodimate"
       name="Kodimate"
       version="0.1.0"
       provider-name="snrgarb">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
        <import addon="inputstream.ffmpegdirect" version="21.3.8"/>
    </requires>
    <extension point="xbmc.python.script" library="default.py">
        <provides>video</provides>
    </extension>
    <extension point="xbmc.service" library="service.py" />
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">TiviMate-style IPTV client: numbered channel list, EPG guide and catch-up</summary>
        <description lang="en_GB">Kodimate is a Kodi addon for M3U and Xtream Codes IPTV providers. It replaces Kodi's PVR with its own Live TV view: a numbered channel list, an EPG guide, on-screen-display zapping, and catch-up playback for channels that support it.</description>
        <license>GPL-2.0-or-later</license>
        <platform>all</platform>
        <source>https://github.com/snrgarb/kodimate</source>
        <assets>
            <icon>icon.png</icon>
            <fanart>fanart.jpg</fanart>
        </assets>
    </extension>
</addon>
