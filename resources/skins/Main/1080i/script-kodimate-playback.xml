<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<window>
    <coordinates>
        <system>1</system>
        <posx>0</posx>
        <posy>0</posy>
    </coordinates>
    <controls>
        <control type="image">
            <posx>0</posx>
            <posy>0</posy>
            <width>1920</width>
            <height>1080</height>
            <texture>white.png</texture>
            <colordiffuse>ff000000</colordiffuse>
            <visible>!String.IsEqual(Window.Property(state),playing)</visible>
        </control>
        <control type="image">
            <posx>910</posx>
            <posy>460</posy>
            <width>100</width>
            <height>100</height>
            <texture>white.png</texture>
            <visible>String.IsEqual(Window.Property(state),connecting) | String.IsEqual(Window.Property(state),reconnecting)</visible>
            <animation effect="rotate" start="0" end="360" center="auto" time="1200" condition="true">Conditional</animation>
        </control>
        <control type="label">
            <posx>80</posx>
            <posy>900</posy>
            <width>1760</width>
            <height>60</height>
            <textcolor>ffffffff</textcolor>
            <font>font12</font>
            <label>$INFO[Window.Property(channel_number)]  $INFO[Window.Property(channel_name)]</label>
        </control>
        <control type="label">
            <posx>80</posx>
            <posy>960</posy>
            <width>1760</width>
            <height>60</height>
            <textcolor>ffcccccc</textcolor>
            <font>font12</font>
            <label>$INFO[Window.Property(status_text)]</label>
        </control>
    </controls>
</window>
