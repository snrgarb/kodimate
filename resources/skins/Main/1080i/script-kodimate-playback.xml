<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<window>
    <defaultcontrol always="true">201</defaultcontrol>
    <coordinates>
        <system>1</system>
        <posx>0</posx>
        <posy>0</posy>
    </coordinates>
    <controls>
        <control type="image">
            <posx>0</posx>
            <posy>0</posy>
            <width>1920</width>
            <height>1080</height>
            <texture>white.png</texture>
            <colordiffuse>ff000000</colordiffuse>
            <visible>!String.IsEqual(Window.Property(state),playing)</visible>
        </control>

        <!-- Busy spinner: Estuary's native DialogBusy spinner, visible while
             connecting or reconnecting. -->
        <control type="group">
            <centerleft>50%</centerleft>
            <centertop>50%</centertop>
            <width>80</width>
            <height>80</height>
            <visible>String.IsEqual(Window.Property(state),connecting) | String.IsEqual(Window.Property(state),reconnecting)</visible>
            <control type="image">
                <centerleft>50%</centerleft>
                <centertop>50%</centertop>
                <width>80</width>
                <height>80</height>
                <aspectratio>keep</aspectratio>
                <animation effect="rotate" end="-45" center="auto" time="200" delay="600" loop="true" reversible="false" condition="true">Conditional</animation>
                <texture colordiffuse="ffffffff">spinner.png</texture>
            </control>
            <control type="image">
                <centerleft>50%</centerleft>
                <centertop>50%</centertop>
                <width>50</width>
                <height>50</height>
                <aspectratio>keep</aspectratio>
                <animation effect="rotate" end="45" center="auto" time="200" delay="600" loop="true" reversible="false" condition="true">Conditional</animation>
                <texture flipx="true" colordiffuse="ffffffff">spinner.png</texture>
            </control>
        </control>

        <!-- Top info bar -->
        <control type="group">
            <visible>String.IsEqual(Window.Property(bar_visible),1)</visible>
            <control type="image">
                <posx>0</posx>
                <posy>0</posy>
                <width>1920</width>
                <height>200</height>
                <texture>white.png</texture>
                <colordiffuse>cc0a0a10</colordiffuse>
            </control>
            <control type="image">
                <posx>60</posx>
                <posy>30</posy>
                <width>140</width>
                <height>140</height>
                <aspectratio>keep</aspectratio>
                <texture fallback="channel-placeholder.png">$INFO[Window.Property(channel_logo)]</texture>
            </control>
            <control type="label">
                <posx>220</posx>
                <posy>30</posy>
                <width>120</width>
                <height>60</height>
                <font>font13</font>
                <textcolor>ffffffff</textcolor>
                <label>$INFO[Window.Property(channel_number)]</label>
            </control>
            <control type="label">
                <posx>220</posx>
                <posy>90</posy>
                <width>700</width>
                <height>50</height>
                <font>font12</font>
                <textcolor>ffcccccc</textcolor>
                <label>$INFO[Window.Property(channel_name)]</label>
            </control>
            <control type="label">
                <posx>940</posx>
                <posy>4</posy>
                <width>200</width>
                <height>24</height>
                <font>font13</font>
                <textcolor>ff3a6ea5</textcolor>
                <label>$ADDON[script.kodimate 32094]</label>
                <visible>String.IsEqual(Window.Property(catchup),1)</visible>
            </control>
            <control type="label">
                <posx>940</posx>
                <posy>30</posy>
                <width>900</width>
                <height>40</height>
                <font>font12</font>
                <textcolor>ffffffff</textcolor>
                <label>$INFO[Window.Property(now_title)]</label>
            </control>
            <control type="image" id="703">
                <posx>940</posx>
                <posy>78</posy>
                <width>600</width>
                <height>8</height>
                <texture>white.png</texture>
                <colordiffuse>ff404040</colordiffuse>
            </control>
            <control type="image" id="704">
                <posx>940</posx>
                <posy>78</posy>
                <width>0</width>
                <height>8</height>
                <texture>white.png</texture>
                <colordiffuse>ff3a6ea5</colordiffuse>
            </control>
            <control type="image" id="705">
                <posx>936</posx>
                <posy>78</posy>
                <width>8</width>
                <height>8</height>
                <texture>white.png</texture>
                <colordiffuse>ffffffff</colordiffuse>
            </control>
            <control type="label">
                <posx>940</posx>
                <posy>96</posy>
                <width>600</width>
                <height>30</height>
                <font>font12</font>
                <textcolor>ffaaaaaa</textcolor>
                <label>$INFO[Window.Property(now_times)]</label>
            </control>
            <control type="label">
                <posx>940</posx>
                <posy>130</posy>
                <width>900</width>
                <height>40</height>
                <font>font12</font>
                <textcolor>ff808080</textcolor>
                <label>$INFO[Window.Property(next_title)]</label>
            </control>
            <control type="label">
                <posx>60</posx>
                <posy>170</posy>
                <width>1760</width>
                <height>30</height>
                <font>font12</font>
                <textcolor>ffcccccc</textcolor>
                <label>$INFO[Window.Property(status_text)]</label>
            </control>
        </control>

        <!-- Large digit-entry label -->
        <control type="label">
            <posx>1600</posx>
            <posy>60</posy>
            <width>260</width>
            <height>120</height>
            <font>font37</font>
            <align>right</align>
            <textcolor>ffffffff</textcolor>
            <label>$INFO[Window.Property(digits)]</label>
            <visible>!String.IsEmpty(Window.Property(digits))</visible>
        </control>

        <!-- Groups/Channels zapping overlay -->
        <control type="group">
            <visible>String.IsEqual(Window.Property(list_visible),1)</visible>
            <control type="image">
                <posx>0</posx>
                <posy>0</posy>
                <width>1200</width>
                <height>1080</height>
                <texture>white.png</texture>
                <colordiffuse>cc0a0a10</colordiffuse>
            </control>
            <control type="list" id="200">
                <posx>40</posx>
                <posy>40</posy>
                <width>420</width>
                <height>1000</height>
                <onup>200</onup>
                <ondown>200</ondown>
                <onleft>200</onleft>
                <onright>201</onright>
                <itemlayout height="70" width="420">
                    <control type="image">
                        <posx>0</posx>
                        <posy>0</posy>
                        <width>420</width>
                        <height>68</height>
                        <texture>white.png</texture>
                        <colordiffuse>ff202020</colordiffuse>
                    </control>
                    <control type="label">
                        <posx>20</posx>
                        <posy>0</posy>
                        <width>380</width>
                        <height>68</height>
                        <textcolor>ffcccccc</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                </itemlayout>
                <focusedlayout height="70" width="420">
                    <control type="image">
                        <posx>0</posx>
                        <posy>0</posy>
                        <width>420</width>
                        <height>68</height>
                        <texture>white.png</texture>
                        <colordiffuse>ff3a6ea5</colordiffuse>
                        <visible>Control.HasFocus(200)</visible>
                    </control>
                    <control type="image">
                        <posx>0</posx>
                        <posy>0</posy>
                        <width>420</width>
                        <height>68</height>
                        <texture>white.png</texture>
                        <colordiffuse>ff2c3e50</colordiffuse>
                        <visible>!Control.HasFocus(200)</visible>
                    </control>
                    <control type="label">
                        <posx>20</posx>
                        <posy>0</posy>
                        <width>380</width>
                        <height>68</height>
                        <textcolor>ffffffff</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                </focusedlayout>
            </control>
            <control type="list" id="201">
                <posx>480</posx>
                <posy>40</posy>
                <width>760</width>
                <height>1000</height>
                <onup>201</onup>
                <ondown>201</ondown>
                <onleft>200</onleft>
                <onright>201</onright>
                <itemlayout height="70" width="760">
                    <control type="label">
                        <posx>0</posx>
                        <posy>0</posy>
                        <width>100</width>
                        <height>68</height>
                        <textcolor>ffcccccc</textcolor>
                        <label>$INFO[ListItem.Label2]</label>
                    </control>
                    <control type="image">
                        <posx>110</posx>
                        <posy>4</posy>
                        <width>100</width>
                        <height>60</height>
                        <aspectratio>keep</aspectratio>
                        <texture fallback="channel-placeholder.png">$INFO[ListItem.Icon]</texture>
                    </control>
                    <control type="label">
                        <posx>230</posx>
                        <posy>2</posy>
                        <width>500</width>
                        <height>38</height>
                        <textcolor>ffcccccc</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label">
                        <posx>230</posx>
                        <posy>36</posy>
                        <width>500</width>
                        <height>30</height>
                        <font>font12</font>
                        <textcolor>ff8a8a8a</textcolor>
                        <label>$INFO[ListItem.Property(now_title)]</label>
                    </control>
                </itemlayout>
                <focusedlayout height="70" width="760">
                    <control type="image">
                        <posx>0</posx>
                        <posy>0</posy>
                        <width>760</width>
                        <height>68</height>
                        <texture>white.png</texture>
                        <colordiffuse>ff3a6ea5</colordiffuse>
                        <visible>Control.HasFocus(201)</visible>
                    </control>
                    <control type="image">
                        <posx>0</posx>
                        <posy>0</posy>
                        <width>760</width>
                        <height>68</height>
                        <texture>white.png</texture>
                        <colordiffuse>ff2c3e50</colordiffuse>
                        <visible>!Control.HasFocus(201)</visible>
                    </control>
                    <control type="label">
                        <posx>0</posx>
                        <posy>0</posy>
                        <width>100</width>
                        <height>68</height>
                        <textcolor>ffffffff</textcolor>
                        <label>$INFO[ListItem.Label2]</label>
                    </control>
                    <control type="image">
                        <posx>110</posx>
                        <posy>4</posy>
                        <width>100</width>
                        <height>60</height>
                        <aspectratio>keep</aspectratio>
                        <texture fallback="channel-placeholder.png">$INFO[ListItem.Icon]</texture>
                    </control>
                    <control type="label">
                        <posx>230</posx>
                        <posy>2</posy>
                        <width>500</width>
                        <height>38</height>
                        <textcolor>ffffffff</textcolor>
                        <label>$INFO[ListItem.Label]</label>
                    </control>
                    <control type="label">
                        <posx>230</posx>
                        <posy>36</posy>
                        <width>500</width>
                        <height>30</height>
                        <font>font12</font>
                        <textcolor>ffcfcfcf</textcolor>
                        <label>$INFO[ListItem.Property(now_title)]</label>
                    </control>
                </focusedlayout>
            </control>
        </control>
    </controls>
</window>
